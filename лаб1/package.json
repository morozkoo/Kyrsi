{
  "name": "currency-converter-api",
  "version": "1.0.0",
  "description": "REST API для конвертации валют и расчета курсов ЦБ РФ",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:demo-users": "sequelize-cli db:seed --seed 20261028000000-demo-users.js",
    "db:seed:byn": "sequelize-cli db:seed --seed 20261028000001-add-byn-currency.js",
    "db:seed:mongo": "node scripts/seedMongoFromPostgres.js",
    "db:reset": "sequelize-cli db:migrate:undo:all"
  },
  "keywords": [
    "nodejs",
    "express",
    "currency",
    "cbr"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.5"
  }
}
